# Copy to .env and adjust. All values are optional — these are the defaults.

# Host port the assistant is published on.
NOVA_VOICE_PORT=8100

# Upstream AI services on Nova. The defaults reach Nova over the LAN and work
# from a dev machine or from a container on Nova. When running on Nova and
# preferring the Docker host gateway, use http://host.docker.internal:<port>.
NOVA_VOICE_STT_URL=http://nova.example.internal:8001
NOVA_VOICE_TTS_URL=http://nova.example.internal:8880
NOVA_VOICE_LLM_URL=http://nova.example.internal:7869

# Assistant name — used in the default prompts and the app title. Change this
# to re-brand the whole assistant in one place.
NOVA_ASSISTANT_NAME=Nova

# Model + default voice. The voice here is only the *default*; once you pick a
# voice in the app's Settings screen, that saved choice takes over (and applies
# to the satellite too). See NOVA_VOICE_SETTINGS_FILE below for where it's saved.
NOVA_VOICE_MODEL=qwen3:8b
NOVA_VOICE_TTS_VOICE=af_heart

# Where user-editable settings from the Settings screen are persisted. The Docker
# compose file overrides this to /data/settings.json on a named volume so the
# choice survives `up -d --build`. Local dev defaults to ./data/settings.json.
# NOVA_VOICE_SETTINGS_FILE=/data/settings.json

# Conversation history (SQLite). Every turn from the web and the satellite is
# logged here so past chats are listable/resumable in the web UI. Compose puts it
# on the same volume (/data/nova.db); local dev defaults to ./data/nova.db.
# History older than NOVA_VOICE_HISTORY_DAYS is auto-pruned to a rolling window.
# NOVA_VOICE_HISTORY_DB=/data/nova.db
NOVA_VOICE_HISTORY_DAYS=7

# Link dashboard (Homepage replacement). The user's edited groups/tiles are saved
# here; absent ⇒ the packaged seed (imported from the old Homepage config) is
# served. Same /data volume as the history + settings stores.
# NOVA_VOICE_DASHBOARD_FILE=/data/dashboard.json

# Activity log — a verbose, capped record of what the assistant is doing (STT,
# chat turns, tool calls, escalations, errors), viewable in the Settings screen
# and served at /api/log. Stored in the history DB above. LEVEL is the capture
# threshold; the buffer is bounded by both an age cutoff (RETENTION_HOURS) and a
# hard row cap (MAX_ROWS), whichever trims first.
NOVA_VOICE_LOG_LEVEL=INFO
NOVA_VOICE_LOG_RETENTION_HOURS=48
NOVA_VOICE_LOG_MAX_ROWS=50000

# Timezone for reminders at clock times ("remind me at 5pm"). IANA name; resolved
# via the tzdata package (the slim image has no system zoneinfo). Empty = the
# container's local time. Countdown timers don't depend on this.
NOVA_VOICE_TIMEZONE=America/Los_Angeles

# How long (s) since a satellite's last heartbeat before it's shown offline in
# the web panel. Keep it above the satellite's poll interval + a turn's length.
NOVA_VOICE_SATELLITE_TTL=30

# Set to 1 to let qwen3 emit its <think> reasoning trace (slower; not spoken).
NOVA_VOICE_THINK=0

# Home Assistant integration. Tools (query/lights/climate) activate only when a
# token is set. Create one in HA: profile → Security → Long-lived access tokens.
NOVA_VOICE_HA_URL=https://homeassistant.example.internal
NOVA_VOICE_HA_TOKEN=
# Domains the assistant may control. `switch` is included because many lights are
# switch entities; `lock` lets it lock/unlock doors. Add scenes, fan, media_player,
# cover, etc. as you want voice to reach them. (State queries are limited to the
# curated set below.)
NOVA_VOICE_HA_CONTROL_DOMAINS=light,climate,switch,lock
# The assistant sees and controls ONLY entities carrying this Home Assistant
# label — a curated allowlist, so it can never target a wrong device from the
# thousands in the registry. Curate by adding this label (and clear friendly
# names) to the entities you want Nova to use, in HA → Settings → Labels.
NOVA_VOICE_HA_LABEL=nova
# How long (s) the labeled-device list is cached before re-fetching from HA.
NOVA_VOICE_HA_DEVICES_TTL=300
# Set to 0 only if HA's cert is from an internal CA the container doesn't trust.
NOVA_VOICE_HA_VERIFY_SSL=1

# Phone notifications over MQTT (optional, #16). When enabled, a reminder/timer/
# alarm firing publishes a small JSON message to your MQTT broker; a single Home
# Assistant automation subscribes to the topic and pushes it to your phone via the
# HA companion app — so reminders reach you with the PWA closed. These are just
# *defaults*: the toggle, categories, address and topic are editable at runtime in
# Settings ▸ Notifications (and persist server-side). Reach the broker by its LAN
# name/port (not a container name). Auth is usually empty on a LAN Mosquitto.
NOVA_VOICE_NOTIFICATIONS_ENABLED=0
NOVA_VOICE_NOTIFICATION_CATEGORIES=reminders,timers
NOVA_VOICE_MQTT_ADDRESS=alfred.example.internal:1883
NOVA_VOICE_MQTT_TOPIC=nova/notify
NOVA_VOICE_MQTT_USERNAME=
NOVA_VOICE_MQTT_PASSWORD=

# Obsidian notes (optional). Nova reads/writes your vault through the "Local
# REST API" Obsidian plugin running on your machine, reached over the LAN. Set
# the URL to that machine's LAN address + the plugin's port (HTTP 27123), and
# the API key from the plugin's settings. Both required to enable notes tools.
# The machine must be awake and Obsidian running for notes to work.
NOVA_OBSIDIAN_URL=http://your-pc.example.internal:27123
NOVA_OBSIDIAN_API_KEY=
# Base folder new projects are created under (vault-relative).
NOVA_OBSIDIAN_PROJECTS_DIR=Projects
# Folder named checklists (shopping, to-do, …) are created in — same place as
# your daily notes. Vault-relative; empty = vault root.
NOVA_OBSIDIAN_DAILY_DIR=Daily Notes
# Only matters for an https:// URL (self-signed cert) — set 0 to skip verify.
NOVA_OBSIDIAN_VERIFY_SSL=1

# Web search (optional). Points the assistant at a self-hosted SearXNG instance
# so it can look up current/external facts instead of saying it has no internet
# access. The query leaves your network only via SearXNG. Web search tools
# activate only when a URL is set. IMPORTANT: SearXNG must have the JSON format
# enabled — add `json` under `search.formats` in its settings.yml and restart.
NOVA_SEARXNG_URL=
# How many results to hand the model per search (it summarizes them).
NOVA_SEARXNG_RESULTS=5
# Set 0 only if SearXNG's cert is from an internal CA the container doesn't trust.
NOVA_SEARXNG_VERIFY_SSL=1

# Shop-manual RAG (optional, #63). Upload PDF manuals in Settings ▸ Manuals; Nova
# extracts the text, embeds it, and indexes the vectors in Qdrant so it can answer
# questions from your manuals with search_manuals. Activates only when a Qdrant URL
# is set. Embeddings reuse the Ollama service above — pull the model once on Nova:
#   ollama pull nomic-embed-text
NOVA_QDRANT_URL=
# Collection the manual chunks live in (created automatically on first upload).
NOVA_QDRANT_COLLECTION=nova_manuals
# Optional Qdrant API key (sent as the api-key header); leave empty on a trusted LAN.
NOVA_QDRANT_API_KEY=
# Set 0 only if Qdrant's cert is from an internal CA the container doesn't trust.
NOVA_QDRANT_VERIFY_SSL=1
# Ollama embedding model (must be pulled on Nova). Vector size is auto-detected.
NOVA_EMBED_MODEL=nomic-embed-text
# How many manual passages to hand the model per search (it reads + summarizes).
NOVA_MANUALS_TOP_K=5
# Text chunking (characters, ~4 chars/token) and the minimum cosine score to keep.
NOVA_MANUALS_CHUNK_CHARS=1200
NOVA_MANUALS_CHUNK_OVERLAP=200
NOVA_MANUALS_MIN_SCORE=0.3
# Where uploaded PDFs are stored. In Docker this is set to /data/manuals (volume).
# NOVA_MANUALS_DIR=

# Cameras via Frigate (optional, #68). Set your Frigate URL to let the user "pull
# up" a camera: Nova matches a spoken name to a Frigate camera and the PWA opens a
# modal with the live feed. Frigate's bundled go2rtc restreams each RTSP camera as
# browser-playable HLS; the backend proxies that (and JPEG snapshots) same-origin,
# so the browser never talks to Frigate directly. Activates only when a URL is set.
NOVA_FRIGATE_URL=
# Set 0 only if Frigate's cert is from an internal CA the container doesn't trust.
NOVA_FRIGATE_VERIFY_SSL=1
# How long (seconds) the camera list is cached before re-fetching from Frigate.
NOVA_FRIGATE_CAMERAS_TTL=300

# Live homelab metrics for the constellation HUD (read-only, LAN-direct). Beszel is
# a PocketBase monitoring hub — per-host CPU/mem/disk (email+password auth). Optional;
# empty ⇒ the source is skipped and the HUD shows whatever's left. Frigate (above)
# adds a small NVR readout. Secrets live in the on-Nova .env, never committed.
NOVA_BESZEL_URL=
NOVA_BESZEL_USERNAME=
NOVA_BESZEL_PASSWORD=
# Set 0 if the Beszel hub is fronted by a cert the container doesn't trust.
NOVA_BESZEL_VERIFY_SSL=1
# Recent Beszel history points feeding each host's load-average sparkline in the
# HUD (the finest ~15-20s bucket). 0 disables the sparklines.
NOVA_BESZEL_LOAD_POINTS=40
# How long (seconds) the aggregated metrics are cached (shared across surfaces).
NOVA_VOICE_METRICS_TTL=12

# Claude escalation (optional). Set an Anthropic API key to let the user opt in
# to handing a single turn to Claude for research/writing tasks the local model
# can't do well. Each escalation is confirmed first (you see exactly what leaves
# the LAN), and Claude never drives the local tools. Empty key = feature off.
ANTHROPIC_API_KEY=
# The DEEP escalation model — used for the upfront path (research, long-form
# writing, deep reasoning, "ask Claude"), where big-model quality is the point.
NOVA_CLAUDE_MODEL=claude-opus-4-8
# The FAST/cheap escalation model — used for the reactive path (the local model
# tried and struggled). Cheap enough to escalate liberally, and far more reliable
# than qwen3:8b at multi-step tool chains.
NOVA_CLAUDE_FAST_MODEL=claude-haiku-4-5
NOVA_CLAUDE_MAX_TOKENS=8000
# NOVA_CLAUDE_SYSTEM_PROMPT=You are a research and writing assistant...

# Auto-escalation (optional). When on, every chat turn runs on the local model
# first; if it struggles (an empty answer or a punt/deferral), the turn is retried
# on the FAST model (NOVA_CLAUDE_FAST_MODEL) — which drives the SAME local tools
# (manuals, web, Home Assistant…), so hard multi-step turns succeed. Requests that
# clearly want the big brain (research/long-form/"ask Claude") skip the local pass
# and go straight to the DEEP model (NOVA_CLAUDE_MODEL). Off by default: it changes
# the privacy posture — an escalated turn leaves the LAN WITHOUT the per-turn
# confirm gate, and Claude sees the local tool results it needs to act. Needs
# ANTHROPIC_API_KEY. Also toggleable at runtime in Settings ▸ General.
NOVA_VOICE_AUTO_ESCALATE=0

# Optional: override the assistant's personality/behaviour per response mode.
# Voice mode is used for spoken replies (short, no markdown); text mode is used
# by the browser text interface (may use markdown, more detail). Leave unset to
# use the built-in defaults, which are filled with NOVA_ASSISTANT_NAME.
# NOVA_VOICE_SYSTEM_PROMPT=You are Nova, a concise private voice assistant...
# NOVA_TEXT_SYSTEM_PROMPT=You are Nova, responding in a text interface...

# ── Arize AX tracing (optional) ─────────────────────────────────────────────
# Traces the agent loop (turn, router, model, tools, retrieval, escalation) to
# Arize AX over OpenTelemetry/OpenInference. Both values come from the Arize
# onboarding screen and keep Arize's own names so they paste straight across.
# Leave ARIZE_API_KEY empty to disable: tracing then costs nothing and imports
# nothing (see app/tracing.py).
#
# PRIVACY: with this on, prompts, tool arguments and tool results leave the LAN
# for Arize's cloud. It is the one deliberate exception to this app's "nothing
# leaves the network" rule — keep it off unless you mean it.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Project name traces land under in the Arize UI.
NOVA_ARIZE_PROJECT=nova-voice
